{
  "name": "nappagochi-napplet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-outbox-dev.mjs",
    "dev:vite": "vite --host 127.0.0.1 --port 5188 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "verify": "pnpm type-check && pnpm build",
    "build:conformance": "VITE_DEV_PRIVKEY_HEX=0101010101010101010101010101010101010101010101010101010101010101 vite build",
    "test:conformance": "pnpm build:conformance && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\"",
    "test:fixtures": "node --test scripts/create-pet-fixtures.test.mjs",
    "test:fixtures:matrix": "node scripts/create-pet-fixtures.mjs --matrix",
    "test:fixture:nsec": "node scripts/create-pet-fixtures.mjs --paste-nsec",
    "test:demo-seed": "node --test scripts/seed-demo-relay.test.mjs",
    "test:view-mode": "node --test scripts/view-mode.test.mjs",
    "test:activity": "node --test scripts/activity-reconciliation.test.mjs",
    "test:habitat": "node --test scripts/habitat-sickness.test.mjs",
    "test:profile-scoring": "node --test scripts/profile-scoring.test.mjs",
    "test:emotion": "node --test scripts/pet-emotion.test.mjs",
    "test:speech": "node --test scripts/pet-speech.test.mjs",
    "test:enrichment": "node --test scripts/reaction-enrichment.test.mjs",
    "test:live": "node --test scripts/live-session.test.mjs scripts/live-aggregation.test.mjs",
    "test:event-routing": "node --test scripts/event-routing.test.mjs",
    "test:paja-debug": "node --test scripts/paja-nsec-debug-patch.test.mjs",
    "test:relay-copy": "node --test scripts/copy-events-to-local-relay.test.mjs",
    "test:routing": "node --test scripts/publish-routing.test.mjs",
    "test:local-relay": "node --test scripts/local-test-relay.test.mjs",
    "relay:local": "deno run --allow-net=127.0.0.1:7777 --allow-read=.pet-test/local-relay --allow-write=.pet-test/local-relay scripts/local-test-relay.ts --port 7777 --data .pet-test/local-relay/events.json",
    "demo:seed": "node scripts/seed-demo-relay.mjs",
    "demo:local": "node scripts/start-local-demo.mjs",
    "paja:outbox": "node scripts/start-paja-outbox.mjs",
    "paja:debug": "node scripts/start-paja-nsec-debug.mjs",
    "paja:hybrid": "kehto paja --target-url http://127.0.0.1:5188/ --identity-mode anonymous --relay-mode live --relay-url ws://127.0.0.1:7777 --relay-url wss://nos.lol --relay-url wss://relay.damus.io --relay-url wss://relay.primal.net --relay-url wss://relay.snort.social --storage-mode memory --config-value nostrPetLocalRelayMirror=true --port 5197",
    "relay:copy": "node scripts/copy-events-to-local-relay.mjs",
    "relay:query": "node scripts/query-local-relay.mjs --relay ws://127.0.0.1:7777"
  },
  "dependencies": {
    "@napplet/sdk": "^0.25.0"
  },
  "devDependencies": {
    "@kehto/paja": "0.8.0",
    "@napplet/conformance-cli": "^0.2.16",
    "@napplet/vite-plugin": "^0.12.0",
    "nostr-tools": "2.23.5",
    "playwright": "1.61.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "license": "MIT"
}
