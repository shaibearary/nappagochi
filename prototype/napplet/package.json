{
  "name": "nostr-pet-napplet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "type-check": "tsc --noEmit",
    "verify": "pnpm type-check && pnpm build",
    "build:conformance": "VITE_DEV_PRIVKEY_HEX=0101010101010101010101010101010101010101010101010101010101010101 vite build",
    "test:conformance": "pnpm build:conformance && napplet-conformance ./dist",
    "test:conformance:ui": "napplet-conformance --ui . --exec \"vite build --watch\"",
    "test:fixtures": "node --test scripts/create-pet-fixtures.test.mjs",
    "test:fixtures:matrix": "node scripts/create-pet-fixtures.mjs --matrix",
    "test:fixture:nsec": "node scripts/create-pet-fixtures.mjs --paste-nsec",
    "test:local-relay": "node --test scripts/local-test-relay.test.mjs",
    "relay:local": "deno run --allow-net=127.0.0.1:7777 --allow-read=.pet-test/local-relay --allow-write=.pet-test/local-relay scripts/local-test-relay.ts --port 7777 --data .pet-test/local-relay/events.json",
    "relay:query": "node scripts/query-local-relay.mjs --relay ws://127.0.0.1:7777"
  },
  "dependencies": {
    "@napplet/sdk": "^0.25.0"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "^0.2.16",
    "@napplet/vite-plugin": "^0.12.0",
    "nostr-tools": "2.23.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "license": "MIT"
}
